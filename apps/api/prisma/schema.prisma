generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model Work {
  id            String            @id @default(cuid())
  title         String
  originalLocale String
  parentWorkId  String?
  parentWork    Work?             @relation("WorkParent", fields: [parentWorkId], references: [id], onDelete: Restrict)
  childWorks    Work[]            @relation("WorkParent")
  languageEditions LanguageEdition[]
  jobs          Job[]
  /// Work-wide sparse thumbnail appearance, shared by every Language Edition.
  thumbnailAppearanceJson String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model LanguageEdition {
  id                     String          @id @default(cuid())
  workId                 String
  work                   Work            @relation(fields: [workId], references: [id], onDelete: Restrict)
  locale                 String
  currentScriptVersionId String?         @unique
  currentScriptVersion   ScriptVersion?  @relation("EditionCurrent", fields: [currentScriptVersionId], references: [id], onDelete: Restrict)
  scriptVersions         ScriptVersion[] @relation("EditionVersions")
  thumbnails             Thumbnail[]     @relation("EditionThumbnails")
  primaryThumbnailId     String?         @unique
  primaryThumbnail       Thumbnail?      @relation("EditionPrimaryThumbnail", fields: [primaryThumbnailId], references: [id], onDelete: SetNull)
  youtubeVideoSettings   YouTubeVideoSettings?
  jobs                   Job[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@unique([workId, locale])
}

model ScriptVersion {
  id                  String          @id @default(cuid())
  languageEditionId   String
  languageEdition     LanguageEdition @relation("EditionVersions", fields: [languageEditionId], references: [id], onDelete: Restrict)
  versionNumber       Int
  contentSchemaVersion Int
  contentJson         String
  author              String          @default("human")
  authorAgentId       String?
  agentRequestId      String?
  agentRequestHash    String?
  sourceScriptVersionId String?
  sourceScriptVersion ScriptVersion?  @relation("ScriptSource", fields: [sourceScriptVersionId], references: [id], onDelete: Restrict)
  derivedVersions     ScriptVersion[] @relation("ScriptSource")
  currentForEdition   LanguageEdition? @relation("EditionCurrent")
  jobs                Job[]
  createdAt           DateTime        @default(now())

  @@unique([languageEditionId, versionNumber])
  @@unique([languageEditionId, agentRequestId])
}

/// Idempotency ledger for the high-cost agent operations (`tts.create`,
/// `tts.createBulk`, `render.start`, `composition.publish`). The row stores a
/// result reference (resource ids), never a response snapshot, so a replay
/// rebuilds the answer from the current resource state.
model AgentRequest {
  id          String   @id @default(cuid())
  operation   String
  agentId     String
  requestId   String
  requestHash String
  /// JSON encoded reference to the created resource(s). `null` while the
  /// operation is still in flight.
  resultRef   String?
  createdAt   DateTime @default(now())

  @@unique([operation, agentId, requestId])
  @@index([createdAt])
}

model Asset {
  id              String           @id @default(cuid())
  kind            String
  origin          String
  status          String
  storageKey      String           @unique
  originalFilename String
  mediaType       String
  byteSize        BigInt
  sha256          String           @unique
  durationMs      Int?
  widthPx         Int?
  heightPx        Int?
  hasAudio        Boolean          @default(false)
  tagsJson        String?
  favoritedAt     DateTime?
  archivedAt      DateTime?
  provenanceJson  String?
  generatedByJobId String?
  generatedByJob  Job?             @relation("GeneratedAssets", fields: [generatedByJobId], references: [id], onDelete: Restrict)
  renditions      AssetRendition[]
  jobs            Job[]
  createdAt       DateTime         @default(now())
}

model AssetRendition {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  purpose    String
  storageKey String
  mediaType  String
  sha256     String
  byteSize   BigInt
  durationMs Int?
  widthPx    Int?
  heightPx   Int?
  codecJson  String?
  createdAt  DateTime @default(now())

  @@unique([assetId, purpose])
}

model VoiceProfile {
  id           String           @id @default(cuid())
  name         String
  adapterId    String
  voiceId      String           @default("")
  locale       String           @default("ja-JP")
  settingsJson String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  voices       CharacterVoice[]

  @@index([adapterId])
}

model Character {
  id          String                @id @default(cuid())
  name        String
  names       CharacterName[]
  appearances CharacterAppearance[]
  voices      CharacterVoice[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model CharacterName {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([characterId, locale])
  @@index([characterId])
}

model CharacterVoice {
  id             String      @id @default(cuid())
  characterId    String
  character      Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  locale         String
  voiceProfileId String
  voiceProfile   VoiceProfile @relation(fields: [voiceProfileId], references: [id], onDelete: Restrict)
  position       Int         @default(0)
  createdAt      DateTime    @default(now())

  @@unique([characterId, locale])
  @@index([characterId])
  @@index([voiceProfileId])
}

model CharacterAppearance {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  assetId     String
  expression  String
  pose        String
  label       String?
  faceSetId   String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([characterId])
  @@index([assetId])
  @@index([faceSetId])
}

model FaceSet {
  id          String             @id @default(cuid())
  name        String
  revisions   FaceSetRevision[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

/// Immutable snapshot of a Face Set. A work-local Appearance pins the
/// versionNumber it was copied or explicitly updated to; library Characters
/// always resolve the latest revision.
model FaceSetRevision {
  id            String             @id @default(cuid())
  faceSetId     String
  faceSet       FaceSet            @relation(fields: [faceSetId], references: [id], onDelete: Cascade)
  versionNumber Int
  layers        FaceLayer[]
  expressions   ExpressionPreset[]
  createdAt     DateTime           @default(now())

  @@unique([faceSetId, versionNumber])
}

model FaceLayer {
  faceSetRevisionId String
  faceSetRevision   FaceSetRevision @relation(fields: [faceSetRevisionId], references: [id], onDelete: Cascade)
  id                String
  part              String
  assetId           String
  blinkLayerId      String?
  speakingLayerId   String?
  position          Int      @default(0)
  createdAt         DateTime @default(now())

  @@id([faceSetRevisionId, id])
  @@index([assetId])
}

model ExpressionPreset {
  faceSetRevisionId String
  faceSetRevision   FaceSetRevision @relation(fields: [faceSetRevisionId], references: [id], onDelete: Cascade)
  id                String
  name              String
  browLayerId       String?
  eyeLayerId        String?
  mouthLayerId      String?
  position          Int      @default(0)
  createdAt         DateTime @default(now())

  @@id([faceSetRevisionId, id])
}

model Job {
  id                    String          @id @default(cuid())
  kind                  String
  status                String
  workId                String?
  work                  Work?           @relation(fields: [workId], references: [id], onDelete: Restrict)
  assetId               String?
  asset                 Asset?          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  languageEditionId     String?
  languageEdition       LanguageEdition? @relation(fields: [languageEditionId], references: [id], onDelete: Restrict)
  scriptVersionId       String?
  scriptVersion         ScriptVersion?  @relation(fields: [scriptVersionId], references: [id], onDelete: Restrict)
  snapshotSchemaVersion Int
  inputSnapshotJson     String
  resultJson            String?
  progressPercent       Int             @default(0)
  errorCode             String?
  errorMessage          String?
  artifacts             Artifact[]
  generatedAssets       Asset[]         @relation("GeneratedAssets")
  createdAt             DateTime        @default(now())
  startedAt             DateTime?
  finishedAt            DateTime?

  @@index([status, createdAt])
  @@index([workId, createdAt])
  @@index([assetId, createdAt])
}

model Artifact {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  role       String
  format     String
  storageKey String   @unique
  sha256     String
  byteSize   BigInt
  durationMs Int?
  widthPx    Int?
  heightPx   Int?
  fps        Float?
  videoCodec String?
  audioCodec String?
  createdAt  DateTime @default(now())

  @@index([jobId])
}

model Composition {
  id                   String               @id @default(cuid())
  name                 String
  runtimeCompositionId String               @unique
  draft                CompositionDraft?
  versions             CompositionVersion[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model CompositionDraft {
  id                 String      @id @default(cuid())
  compositionId      String      @unique
  composition        Composition @relation(fields: [compositionId], references: [id], onDelete: Restrict)
  entrypoint         String
  storageKey         String      @unique
  updatedAt          DateTime    @updatedAt
  authoringStyleJson String?
}

model CompositionVersion {
  id                  String      @id @default(cuid())
  compositionId       String
  composition         Composition @relation(fields: [compositionId], references: [id], onDelete: Restrict)
  versionNumber       Int
  bundleHash          String
  storageKey          String      @unique
  manifestJson        String
  createdAt           DateTime    @default(now())
  styleProvenanceJson String?

  @@unique([compositionId, versionNumber])
}

model Theme {
  id         String          @id @default(cuid())
  name       String
  archivedAt DateTime?
  draft      ThemeDraft?
  revisions  ThemeRevision[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model ThemeDraft {
  id             String   @id @default(cuid())
  themeId        String   @unique
  theme          Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  definitionJson String
  updatedAt      DateTime @updatedAt
}

model ThemeRevision {
  id             String   @id @default(cuid())
  themeId        String
  theme          Theme    @relation(fields: [themeId], references: [id], onDelete: Restrict)
  versionNumber  Int
  definitionJson String
  createdAt      DateTime @default(now())

  @@unique([themeId, versionNumber])
}

model Thumbnail {
  id                String          @id @default(cuid())
  languageEditionId String
  languageEdition   LanguageEdition @relation("EditionThumbnails", fields: [languageEditionId], references: [id], onDelete: Restrict)
  primaryForEdition LanguageEdition? @relation("EditionPrimaryThumbnail")
  label             String
  schemaVersion     Int
  templateId        String
  templateVersion   Int
  inputJson         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([languageEditionId])
}

/// App-wide named snapshot of a Thumbnail Appearance patch. Applying a preset
/// copies its patch into Work.thumbnailAppearanceJson; the Work does not
/// reference the preset afterwards.
model ThumbnailAppearancePreset {
  id             String   @id @default(cuid())
  name           String
  appearanceJson String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
}

model YouTubeVideoSettings {
  id                String          @id @default(cuid())
  languageEditionId String          @unique
  languageEdition   LanguageEdition @relation(fields: [languageEditionId], references: [id], onDelete: Cascade)
  schemaVersion     Int             @default(1)
  settingsJson      String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model YouTubeSettingsTemplate {
  id           String   @id @default(cuid())
  name         String   @unique
  settingsJson String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
}
